# ============================
# LLM Provider
# ============================
# principal = ollama (local, zero cost) | fallback = groq (free tier)
LLM_PRIMARY_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=groq

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.1-8b-instant

# ============================
# ChromaDB
# ============================
CHROMA_PERSIST_DIR=./app/data/chroma_store
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ============================
# Praguri (thresholds) - din documentatie, sectiunea 6.5
# ============================
SIMILARITY_THRESHOLD=0.75
MIN_TICKETS_PER_CLUSTER=3
ASSESSMENT_CONFIDENCE_THRESHOLD=0.6
CLUSTERING_WINDOW_MINUTES=20

# ============================
# Observabilitate (Arize Phoenix)
# ============================
PHOENIX_HOST=localhost
PHOENIX_PORT=6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# ============================
# API / App
# ============================
API_HOST=0.0.0.0
API_PORT=8000
MOCK_JIRA_PORT=8002
LOG_LEVEL=INFO
